\ mwow_timeseries.jnl
\
\ Plot wind speed from an MWOW v0.2 file at a single grid point across
\ all orbits (satellite passes).
\
\ Usage:
\   go mwow_timeseries <file> <latitude> <longitude>
\
\ Examples:
\   go mwow_timeseries "/data/mwow/MWOW_L3_20260321T00_20260321T06_EPI_v0.2.nc" (-54) 90
\   go mwow_timeseries my_mwow_file.nc (-38) 70
\
\ Notes:
\   - Negative latitudes and longitudes must be enclosed in parentheses.
\   - MWOW v0.2 NetCDF dimensions are (orbit, latitude, longitude).
\     The /order=zyx qualifier maps orbit->Z, latitude->Y, longitude->X.
\   - Each K index corresponds to one satellite pass in the file.
\   - The plot x-axis shows orbit index (K); use the pyFerret bridge
\     for time-axis plotting.
\
\ Arguments:
\   $1  MWOW v0.2 NetCDF file path
\   $2  Latitude (degrees, negative for south)
\   $3  Longitude (degrees, negative for west)

cancel mode verify

say *** Loading MWOW data from $1
use/order=zyx "$1"

say *** Extracting wind_speed at lat=$2, lon=$3 across all orbits

let mwow_ws_point = wind_speed[y=$2, x=$3]

plot/title="MWOW Wind Speed at ($2, $3)"/vlabel="Wind Speed [m/s]"/hlabel="Orbit Index" mwow_ws_point

set mode/last verify
